rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function room(roomId) { return get(/databases/$(database)/documents/rooms/$(roomId)); }
    function memberPath(roomId, uid) { return /databases/$(database)/documents/rooms/$(roomId)/members/$(uid); }
    function isMember(roomId) {
      return signedIn() && exists(memberPath(roomId, request.auth.uid))
        && room(roomId).data.expiresAt > request.time;
    }
    function isAdmin(roomId) {
      return isMember(roomId) && get(memberPath(roomId, request.auth.uid)).data.role == 'admin';
    }

    match /rooms/{roomId} {
      allow get: if signedIn() && resource.data.expiresAt > request.time;
      allow list: if false;
      allow create, update, delete: if false;

      match /members/{uid} {
        allow read: if isMember(roomId);
        allow update: if isMember(roomId) && request.auth.uid == uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['online', 'lastSeen'])
          && request.resource.data.online is bool;
        allow create, delete: if false;
      }
      match /messages/{messageId} {
        allow read: if isMember(roomId);
        allow create: if isMember(roomId)
          && request.resource.data.senderUid == request.auth.uid
          && request.resource.data.displayName == get(memberPath(roomId, request.auth.uid)).data.displayName
          && request.resource.data.createdAt == request.time
          && ((request.resource.data.kind == 'text'
              && request.resource.data.text is string
              && request.resource.data.text.size() > 0
              && request.resource.data.text.size() <= 255)
            || (request.resource.data.kind == 'gif'
              && request.resource.data.text is string
              && request.resource.data.text.size() <= 255
              && request.resource.data.gifUrl is string
              && request.resource.data.gifUrl.size() <= 500
              && request.resource.data.gifUrl.matches('https://.*')));
        allow update: if false;
        // Deletion goes through the callable function so it always enters the admin log.
        allow delete: if false;
      }
      match /activity/{eventId} {
        allow read: if isAdmin(roomId);
        allow write: if false;
      }
      match /blocked/{uid} { allow read, write: if false; }
    }
    match /roomSecrets/{roomId} { allow read, write: if false; }
    match /joinAttempts/{attemptId} { allow read, write: if false; }
  }
}
